# Backend settings. Locally the defaults in application.yml match docker-compose.yml, so none of
# these are required for development. In production set them in the Render dashboard.
# The full table is in README.md.

DATABASE_URL=jdbc:postgresql://localhost:5432/sjakkportal
DATABASE_USERNAME=sjakkportal
DATABASE_PASSWORD=sjakkportal
# DATABASE_POOL_SIZE=5

# Base64, at least 256 bits:  openssl rand -base64 48
SJAKKPORTAL_JWT_SECRET=

# Exact frontend origins, comma-separated.
SJAKKPORTAL_ALLOWED_ORIGINS=http://localhost:5173

# Lax when the frontend proxies /api (same site); None only if the browser calls the API cross-site.
SJAKKPORTAL_COOKIE_SAME_SITE=Lax

# First admin; created on startup only when no admin exists. Must change password at first login.
SJAKKPORTAL_ADMIN_USERNAME=
SJAKKPORTAL_ADMIN_PASSWORD=

# Client address for per-address rate limits behind proxies. Empty = the connection address.
# See docs/SECURITY.md before setting.
SJAKKPORTAL_CLIENT_IP_HEADER=
SJAKKPORTAL_CLIENT_IP_TRUSTED_HOPS=1

# PORT=8080
