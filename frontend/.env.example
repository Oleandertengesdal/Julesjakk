# Copy to .env.local for local overrides, or set these in Vercel → Project → Settings → Environment Variables.
# All values end up in the public JavaScript bundle: never put secrets here.

# Where the API lives. Leave empty when /api is served from the same origin
# (the Vite dev server proxy locally, the vercel.json rewrite in production).
VITE_API_URL=

# Where the live-update WebSocket connects. Vercel cannot proxy WebSockets, so in production
# point this straight at the backend, e.g. wss://sjakkportal-api.onrender.com/ws
# Leave empty locally (the dev server proxies /ws).
VITE_WS_URL=
